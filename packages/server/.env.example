# AI sağlayıcı yapılandırması (kopyala → .env). .env Git'e EKLENMEZ.
# AHB_PROVIDER: gemini | documentai | (boş → mock)
# gemini seçilince KADEMELİ olur: hızlı flash birincil + şüphede pro'ya yükselt + (opsiyonel) DocAI yedek.
AHB_PROVIDER=gemini

# --- Gemini (kademeli) ---
GEMINI_API_KEY=buraya_anahtarini_yapistir
# Birincil (hızlı) model.
GEMINI_MODEL=gemini-2.5-flash
# Şüpheli sonuçta (toplam tutmuyor / düşük güven / şema bozuk) yükseltilecek güçlü model.
# Yükseltmeyi kapatmak için: AHB_ESCALATION_MODEL=off
AHB_ESCALATION_MODEL=gemini-2.5-pro
# Gemini tümüyle erişilemezse (aşırı yük/kota) yedek sağlayıcı: documentai | (boş → yedek yok)
AHB_FALLBACK=documentai

# --- Google Document AI (Expense Parser) ---
# AHB_PROVIDER=documentai iken gerekli.
DOCAI_PROJECT_ID=gcp-proje-kimligi
DOCAI_LOCATION=eu
DOCAI_PROCESSOR_ID=islemci-kimligi
# Servis hesabı JSON anahtar dosyasının yolu (rol: Document AI API User). Git'e EKLENMEZ.
GOOGLE_APPLICATION_CREDENTIALS=./docai-sa.json
# Prod'da kapalı tut (her istekte diske ham yanıt yazar): DOCAI_DEBUG=0
DOCAI_DEBUG=0

PORT=8787
