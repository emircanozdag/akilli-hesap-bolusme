{
  "name": "@ahb/server",
  "version": "0.1.0",
  "private": true,
  "description": "İnce AI orkestrasyon backend'i (Hono). Deploy hedefi: Cloudflare Workers; yerelde Node ile çalışır.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.node.ts",
