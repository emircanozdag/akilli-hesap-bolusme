{
  "name": "@ahb/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eas:init": "eas init",
    "eas:build": "eas build --platform ios --profile production"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  },
  "dependencies": {
    "@ahb/ai-orchestrator": "*",
    "@ahb/split-engine": "*",
    "expo": "54.0.35",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
