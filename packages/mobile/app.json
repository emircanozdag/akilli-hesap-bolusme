{
  "expo": {
    "name": "SplitTab",
    "slug": "akilli-hesap-bolusme",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "ahb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0b0e1a"
    },
    "ios": {
      "bundleIdentifier": "com.ahb.akillihesapbolusme",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Fişi taramak için kameraya erişim gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Fişin fotoğrafını seçmek için galeriye erişim gerekiyor."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0b0e1a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fişin fotoğrafını seçmek için galeriye erişim gerekiyor.",
          "cameraPermission": "Fişi taramak için kameraya erişim gerekiyor."
        }
      ],
      "expo-sqlite"
    ]
  }
}
